# Hostinger (LiteSpeed) rules. The canonical host must match `site` in src/routes/+page.svelte.
RewriteEngine On

# One canonical address: HTTPS without www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://catwalk21salon.com%{REQUEST_URI} [L,R=301]

# Retired pages from the old template site.
RewriteRule ^blog\.html$ / [L,R=301]
RewriteRule ^contact\.php$ - [G]

# Hashed build assets never change; everything else revalidates.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_app/immutable/" IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
  <FilesMatch "\.(jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
